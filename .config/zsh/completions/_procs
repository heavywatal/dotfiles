(( $+functions[_procs_commands] )) ||
_procs_commands() {
    local commands; commands=()
    _describe -t commands 'procs commands' commands "$@"
}

if [ "$funcstack[1]" = "_procs" ]; then
    _procs "$@"
else
    compdef _procs procs
fi
